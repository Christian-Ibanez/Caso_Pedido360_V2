# Copiar a .env en ec2-apps y completar.

# --- Entra ID (Azure AD) para el BFF ---
ENTRA_TENANT_ID=85ffb3f2-fe8a-4eef-9c3d-f1f4983a31b6
API_CLIENT_ID=c11a2330-26f6-4d03-a29b-9f43c9f47078
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Oracle cloud (OCI). Todas las tablas llevan prefijo P360_ asi que los micros pueden compartir usuario ---
# Autonomous DB (TLS sin wallet): jdbc:oracle:thin:@(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=adb.sa-santiago-1.oraclecloud.com))(connect_data=(service_name=xxxx_pedidos360_high.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))
# Oracle local del perfil oracle-local: jdbc:oracle:thin:@//oracle:1521/FREEPDB1
DB_URL=jdbc:oracle:thin:@//oracle:1521/FREEPDB1
DB_USERNAME=pedidos360
DB_PASSWORD=pedidos360

# --- ec2-mq (IP privada): los 2 nodos del cluster RabbitMQ ---
RABBITMQ_ADDRESSES=10.0.1.10:5672,10.0.1.10:5673
RABBITMQ_USER=pedidos360
RABBITMQ_PASSWORD=pedidos360

# --- ec2-kafka (IP privada): los 3 brokers ---
KAFKA_BOOTSTRAP_SERVERS=10.0.1.20:9092,10.0.1.20:9093,10.0.1.20:9094
