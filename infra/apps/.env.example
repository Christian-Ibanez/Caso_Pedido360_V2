# Copiar a .env en ec2-apps y completar.

# Origen del frontend (corre local con Vite). Los micros no se exponen al navegador, pero se deja por consistencia.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Oracle: contenedor "oracle" de este mismo compose. Tablas con prefijo P360_, todos los micros comparten usuario ---
# Para usar una base cloud (Autonomous DB, TLS sin wallet):
#   jdbc:oracle:thin:@(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=adb.sa-santiago-1.oraclecloud.com))(connect_data=(service_name=xxxx_pedidos360_high.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))
DB_URL=jdbc:oracle:thin:@//oracle:1521/FREEPDB1
DB_USERNAME=pedidos360
DB_PASSWORD=pedidos360

# --- ec2-mq (IP PRIVADA): los 2 nodos del cluster RabbitMQ ---
RABBITMQ_ADDRESSES=172.31.17.150:5672,172.31.17.150:5673
RABBITMQ_USER=pedidos360
RABBITMQ_PASSWORD=pedidos360
# API HTTP de Management (la usa ms-mqadmin para listar colas, exchanges y bindings)
RABBITMQ_MANAGEMENT_URLS=http://172.31.17.150:15672,http://172.31.17.150:15673

# --- Kafka: desactivado (no hay ec2-kafka). Para activarlo: KAFKA_ENABLED=true, los brokers y --profile kafka ---
KAFKA_ENABLED=false
# KAFKA_BOOTSTRAP_SERVERS=<IP_PRIVADA_EC2_KAFKA>:9092,<IP_PRIVADA_EC2_KAFKA>:9093,<IP_PRIVADA_EC2_KAFKA>:9094
